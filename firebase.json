{
  "hosting": {
    "public": ".",
    "ignore": [
      ".git/**",
      ".git",
      ".claude/**",
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "*.md",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/@(index.html|sw.js|sync.js|firebase-config.js|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}